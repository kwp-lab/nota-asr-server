[Unit]
Description=Nota OpenAI-compatible ASR Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/nota-asr-server
EnvironmentFile=-%h/.config/nota-asr-server.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/workspace/nota-asr-server/.venv/bin/nota-asr-server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
TimeoutStopSec=60

[Install]
WantedBy=default.target

